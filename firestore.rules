rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function
    function isAdmin() {
      return request.auth != null && 
             (request.auth.uid == 'ME2iHxeBWgcSTpc1HKwKbSCrQ7t2' || 
              request.auth.token.email == 'belhalyt01@proton.me');
    }

    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidReadingChallenge(data) {
      return data.keys().hasOnly([
               'userId',
               'year',
               'goal',
               'booksRead',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasAll([
               'userId',
               'year',
               'goal',
               'booksRead',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId == request.auth.uid &&
             data.year is int &&
             data.year >= 2020 &&
             data.year <= 2100 &&
             data.goal is int &&
             data.goal > 0 &&
             data.goal <= 1000 &&
             data.booksRead is list &&
             data.booksRead.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidNewsSource(source) {
      return source is map && source.keys().hasOnly(['label', 'url']) &&
             source.keys().hasAll(['label', 'url']) &&
             source.label is string && source.label.size() > 0 && source.label.size() <= 120 &&
             source.url is string && source.url.size() <= 2048 && source.url.matches('https://[^/]+.*');
    }

    function isValidNewsSourceAt(sources, index) {
      return sources.size() <= index || isValidNewsSource(sources[index]);
    }

    function isValidNewsArticle(data) {
      return data.keys().hasOnly([
               'title', 'slug', 'excerpt', 'body', 'category', 'language', 'authorName',
               'imageUrl', 'imagePath', 'imageAlt', 'sources', 'status',
               'createdAt', 'updatedAt', 'publishedAt'
             ]) && data.keys().hasAll([
               'title', 'slug', 'excerpt', 'body', 'category', 'language', 'authorName',
               'imageUrl', 'imagePath', 'imageAlt', 'sources', 'status',
               'createdAt', 'updatedAt', 'publishedAt'
             ]) &&
             data.title is string && data.title.matches('.*[^\\s].*') && data.title.size() <= 140 &&
             data.slug is string && data.slug.size() <= 100 &&
             (data.slug == '' || data.slug.matches('[a-z0-9]+(-[a-z0-9]+)*')) &&
             data.excerpt is string && data.excerpt.size() <= 240 &&
             data.body is string && data.body.size() <= 100000 &&
             data.category in ['markets', 'forex', 'economy', 'crypto'] && data.language == 'en' &&
             data.authorName is string && data.authorName.size() <= 80 &&
             data.imageUrl is string && data.imageUrl.size() <= 4096 &&
             data.imagePath is string && data.imagePath.size() <= 1024 &&
             data.imageAlt is string && data.imageAlt.size() <= 180 &&
             data.sources is list && data.sources.size() <= 20 &&
             isValidNewsSourceAt(data.sources, 0) && isValidNewsSourceAt(data.sources, 1) &&
             isValidNewsSourceAt(data.sources, 2) && isValidNewsSourceAt(data.sources, 3) &&
             isValidNewsSourceAt(data.sources, 4) && isValidNewsSourceAt(data.sources, 5) &&
             isValidNewsSourceAt(data.sources, 6) && isValidNewsSourceAt(data.sources, 7) &&
             isValidNewsSourceAt(data.sources, 8) && isValidNewsSourceAt(data.sources, 9) &&
             isValidNewsSourceAt(data.sources, 10) && isValidNewsSourceAt(data.sources, 11) &&
             isValidNewsSourceAt(data.sources, 12) && isValidNewsSourceAt(data.sources, 13) &&
             isValidNewsSourceAt(data.sources, 14) && isValidNewsSourceAt(data.sources, 15) &&
             isValidNewsSourceAt(data.sources, 16) && isValidNewsSourceAt(data.sources, 17) &&
             isValidNewsSourceAt(data.sources, 18) && isValidNewsSourceAt(data.sources, 19) &&
             data.status in ['draft', 'published'] &&
             data.createdAt is timestamp && data.updatedAt == request.time &&
             (data.publishedAt == null || data.publishedAt is timestamp) &&
             (data.status == 'draft' || (
               data.slug.size() > 0 && data.excerpt.matches('(?s).*[^\\s].*') &&
               data.body.matches('(?s).*[^\\s].*') && data.authorName.matches('.*[^\\s].*') &&
               data.imageUrl.matches('https://[^/]+.*') && data.imageAlt.matches('.*[^\\s].*') &&
               data.publishedAt is timestamp
             ));
    }

    function isPublishedNews(articleId) {
      return articleId is string &&
             exists(/databases/$(database)/documents/newsArticles/$(articleId)) &&
             get(/databases/$(database)/documents/newsArticles/$(articleId)).data.status == 'published';
    }

    function isPublishedNewsAfter(articleId) {
      return articleId is string &&
             existsAfter(/databases/$(database)/documents/newsArticles/$(articleId)) &&
             getAfter(/databases/$(database)/documents/newsArticles/$(articleId)).data.status == 'published';
    }

    match /newsArticles/{articleId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && isValidNewsArticle(request.resource.data) &&
                    request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && isValidNewsArticle(request.resource.data) &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    (resource.data.publishedAt == null || (
                      request.resource.data.publishedAt == resource.data.publishedAt &&
                      request.resource.data.slug == resource.data.slug
                    ));
      allow delete: if isAdmin();
    }

    match /newsArticleSlugs/{slug} {
      allow get: if isAdmin() || isPublishedNews(resource.data.articleId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                    request.resource.data.keys().hasOnly(['articleId', 'createdAt']) &&
                    request.resource.data.keys().hasAll(['articleId']) &&
                    (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == request.time) &&
                    isPublishedNewsAfter(request.resource.data.articleId) &&
                    getAfter(/databases/$(database)/documents/newsArticles/$(request.resource.data.articleId)).data.slug == slug;
      // Slugs remain permanently reserved, including after unpublish or deletion.
      allow update, delete: if false;
    }

    match /newsConfig/editorial {
      // Empty/missing configuration is public so the feed can use its fallback.
      allow get: if isAdmin() || !exists(/databases/$(database)/documents/newsConfig/editorial) ||
                 resource.data.featuredArticleId == null || isPublishedNews(resource.data.featuredArticleId);
      allow create, update: if isAdmin() &&
                            request.resource.data.keys().hasOnly(['featuredArticleId', 'updatedAt']) &&
                            request.resource.data.keys().hasAll(['featuredArticleId', 'updatedAt']) &&
                            request.resource.data.updatedAt == request.time &&
                            (request.resource.data.featuredArticleId == null ||
                             isPublishedNewsAfter(request.resource.data.featuredArticleId));
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // --- Security Rules for Subcollections ---
      
      // Goals Collection
      match /goals/{goalId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
                      // Basic validation
                      request.resource.data.target is number &&
                      request.resource.data.current is number &&
                      request.resource.data.title is string &&
                      request.resource.data.type in ['balance', 'winRate', 'behavior', 'streak'];
      }

      // Trades Collection
      match /trades/{tradeId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
                      // Basic validation
                      request.resource.data.symbol is string &&
                      request.resource.data.direction in ['LONG', 'SHORT'] &&
                      request.resource.data.entryPrice is number &&
                      request.resource.data.exitPrice is number &&
                      request.resource.data.lotSize is number &&
                      request.resource.data.pnl is number;
      }
      
      // Allow general access to other subcollections (fallback)
      match /{document=**} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Feedback collection - Secured
    match /feedback/{feedbackId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() &&
                    request.auth.token.email is string &&
                    request.resource.data.keys().hasOnly([
                      'message',
                      'userId',
                      'userEmail',
                      'userName',
                      'timestamp',
                      'page',
                      'userAgent',
                      'status',
                      'rating'
                    ]) &&
                    request.resource.data.keys().hasAll([
                      'message',
                      'userId',
                      'userEmail',
                      'userName',
                      'timestamp',
                      'page',
                      'userAgent',
                      'status'
                    ]) &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() > 0 &&
                    request.resource.data.message.size() <= 2000 &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userEmail == request.auth.token.email &&
                    request.resource.data.userName is string &&
                    request.resource.data.page is string &&
                    request.resource.data.page.size() <= 200 &&
                    request.resource.data.userAgent is string &&
                    request.resource.data.userAgent.size() <= 500 &&
                    request.resource.data.status == 'new' &&
                    (!request.resource.data.keys().hasAny(['rating']) ||
                     request.resource.data.rating == null) &&
                    request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Reading Challenges
    match /reading_challenges/{challengeId} {
      allow read, write: if isAdmin();
      allow read: if true;
      allow create: if isAuthenticated() &&
                   isValidReadingChallenge(request.resource.data) &&
                   request.resource.data.createdAt == request.time &&
                   request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    isValidReadingChallenge(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.year == resource.data.year &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
    }

    // Community Messages (Chat)
    match /communityMessages/{messageId} {
      allow read, write: if isAdmin();
      allow read: if true;
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
      
      // Allow updating only specific fields (likes, replies) for community interaction
      // OR allow full update if owner
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies'])
      );
      
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Books collection (readable by everyone, writable only by admin)
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Progress collection
    match /progress/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Favorites collection
    match /favorites/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notes collection
    match /notes/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Highlights collection
    match /highlights/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
