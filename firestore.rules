rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin (replace with your Firebase Auth UID)
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'ME2iHxeBWgcSTpc1HKwKbSCrQ7t2';
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Feedback collection
    match /feedback/{feedbackId} {
      // Anyone can create feedback (authenticated or anonymous)
      allow create: if true;
      
      // Only authenticated users can read feedback
      allow read: if isAuthenticated();
      
      // Only authenticated users can update/delete feedback
      allow update, delete: if isAuthenticated();
    }
    
    // Book summaries - public read, no write (managed by admin)
    match /summaries/{summaryId} {
      allow read: if true;
      allow write: if false; // Controlled via Firebase Console or Admin SDK
    }
    
    // Books collection - public read, admin write
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin(); // Only admin can add/update/delete books
    }
    
    // User favorites - users can only access their own favorites
    match /favorites/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User notes - users can only access their own notes
    match /notes/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User highlights - users can only access their own highlights
    match /highlights/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Reading challenges - SECURED with field validation
    match /reading_challenges/{challengeId} {
      // Validate document structure and data types
      function isValidChallenge() {
        let data = request.resource.data;
        return data.keys().hasAll(['year', 'goal', 'booksRead', 'createdAt', 'updatedAt']) &&
               data.keys().hasOnly(['year', 'goal', 'booksRead', 'createdAt', 'updatedAt']) &&
               data.year is int &&
               data.year >= 2020 &&
               data.year <= 2100 &&
               data.goal is int &&
               data.goal > 0 &&
               data.goal <= 1000 &&
               data.booksRead is list &&
               data.booksRead.size() <= 1000 &&
               data.createdAt is timestamp &&
               data.updatedAt is timestamp;
      }
      
      // Only allow access if authenticated and challengeId matches userId_year pattern
      allow read: if isAuthenticated() && 
                     challengeId.matches('^' + request.auth.uid + '_[0-9]+$');
      
      // On create: validate all fields and timestamps
      allow create: if isAuthenticated() && 
                      challengeId.matches('^' + request.auth.uid + '_[0-9]+$') &&
                      isValidChallenge() &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time;
      
      // On update: validate fields and ensure only allowed fields are modified
      allow update: if isAuthenticated() && 
                      challengeId.matches('^' + request.auth.uid + '_[0-9]+$') &&
                      isValidChallenge() &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.year == resource.data.year;
      
      // On delete: only owner can delete
      allow delete: if isAuthenticated() && 
                      challengeId.matches('^' + request.auth.uid + '_[0-9]+$');
    }
    
    // User progress - users can only access their own progress
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Community messages - authenticated users can read and create, only owners can update/delete
    match /communityMessages/{messageId} {
      // Anyone can read messages (promotes engagement)
      allow read: if true;
      
      // Validate message structure
      function isValidMessage() {
        let data = request.resource.data;
        return data.keys().hasAll(['userId', 'userName', 'userEmail', 'content', 'channel', 'timestamp', 'likes', 'replies']) &&
               data.content is string &&
               data.content.size() > 0 &&
               data.content.size() <= 2000 &&
               data.channel is string &&
               data.channel in ['general', 'books', 'trading', 'insights'] &&
               data.likes is list &&
               data.replies is int &&
               data.replies >= 0;
      }
      
      // Authenticated users can create messages
      allow create: if isAuthenticated() && 
                      isValidMessage() &&
                      request.resource.data.userId == request.auth.uid;
      
      // Authenticated users can update messages (for likes feature)
      allow update: if isAuthenticated();
      
      // Only message owner can delete their own messages
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
