{
  "name": "bookbriefs-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && vite build && npm run prerender:seo",
    "preview": "vite preview",
    "sitemap": "tsx scripts/generate-seo-sitemaps.ts",
    "sitemap:arabic": "tsx scripts/generate-seo-sitemaps.ts",
    "prerender:seo": "tsx scripts/prerender-seo.ts",
    "sync-library": "tsx scripts/sync-library.ts",
    "test:rules": "firebase emulators:exec --project demo-bookbriefs-rules --only firestore \"npm run test:rules:node\"",
    "test:rules:node": "node --test tests/firestore.rules.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.3.0",
    "framer-motion": "^11.11.17",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.546.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.15.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.9.17",
    "dotenv": "^17.2.3",
    "postcss": "^8.4.31",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.3.0",
    "terser": "^5.44.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
